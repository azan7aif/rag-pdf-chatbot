# Copy this file to ".env" and fill in your key. NEVER commit .env to GitHub.

# Choose one: anthropic or gemini
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: leave empty to use the default model for the provider
LLM_MODEL=

# Optional tuning (these are the defaults)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
